{
  "name": "engineering-bootcamp",
  "version": "1.0.0",
  "description": "Liatrio Engineering Bootcamp",
  "main": "index.js",
  "type": "module",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "start": "npm run build:dev && npm run serve:docsify",
    "serve:docsify": "docsify serve --port 3000",
    "build:dev": "webpack --config webpack.dev.ts",
    "build:prod": "webpack --config webpack.prod.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.tools.json && tsc -p .agents",
    "lint": "npm run lint:markdown && npm run lint:links && npm run lint:spelling",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\" \"!**/.venv/**\" \"!**/specs/**\"",
    "lint:links": "node .husky/check-docsify-links.ts",
    "lint:spelling": "cspell --no-progress \"**/*.md\"",
    "test:agents": "node --test \".agents/skills/*/scripts/*.test.ts\"",
    "prepare": "husky",
    "compare-front-matter": "node ./.husky/front-matter-condenser.ts",
    "refresh-front-matter": "node ./.husky/front-matter-condenser.ts update"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liatrio/engineering-bootcamp.git"
  },
  "keywords": [
    "devops",
    "bootcamp"
  ],
  "author": "Liatrio",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liatrio/engineering-bootcamp/issues"
  },
  "homepage": "https://github.com/liatrio/engineering-bootcamp#readme",
  "dependencies": {
    "chart.js": "^4.3.0",
    "chartjs-chart-wordcloud": "^4.2.0",
    "docsify": "5.1.0",
    "docsify-cli": "^5.0.0",
    "docsify-copy-code": "3.0.2",
    "docsify-edit-on-github": "1.0.3",
    "docsify-pagination": "2.10.1",
    "gray-matter": "^4.0.3",
    "node-stdlib-browser": "^1.2.0",
    "prismjs": "1.30.0",
    "quizdown": "0.6.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-typescript": "^8.0.7",
    "@types/node": "^26.6.6",
    "babel-loader": "^10.0.0",
    "cspell": "^10.0.0",
    "husky": "^9.0.11",
    "markdownlint-cli2": "^0.24.0",
    "remark": "^15.0.0",
    "remark-cli": "^12.0.0",
    "typescript": "^7.0.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^7.0.0",
    "webpack-merge": "^6.0.0"
  }
}
