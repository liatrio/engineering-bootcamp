// One development environment with every toolchain the Company app needs:
// .NET (employees, assignments), Python + uv (projects), Go (notifications),
// Node (web), and the Docker CLI talking to your machine's Docker, so
// `docker compose up` and Testcontainers work from inside the container.
{
  "name": "Company app",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.13" },
    "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "containerEnv": {
    // Testcontainers starts containers on your machine's Docker, so tests
    // inside this container must reach them through the host, not localhost.
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal"
  },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "forwardPorts": [8080, 3001, 15672],
  "portsAttributes": {
    "8080": { "label": "Company app" },
    "3001": { "label": "Grafana" },
    "15672": { "label": "RabbitMQ" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
